# Public MCP endpoint
MCP_HOST=0.0.0.0
MCP_PORT=8080
MCP_PUBLIC_URL=https://git-signing.example.com
MCP_ALLOWED_HOSTS=git-signing.example.com,git-signing.example.com:*
MCP_ALLOWED_ORIGINS=

# Authentication. Keep static-bearer for private deployments.
MCP_AUTH_MODE=static-bearer
MCP_BEARER_TOKEN_SOURCE=env
MCP_BEARER_TOKEN=replace-with-a-long-random-secret
# Alternatively:
# MCP_BEARER_TOKEN_FILE=/run/secrets/mcp_bearer_token

# Only these repositories may be modified. fnmatch-style wildcards are supported.
ALLOWED_REPOSITORIES=vitormattos/*
MAX_FILE_BYTES=1048576
MAX_CHANGES=100

# Git identity used for BOTH author and DCO Signed-off-by.
GIT_IDENTITY_NAME=Vitor Mattos
GIT_IDENTITY_EMAIL=1079143+vitormattos@users.noreply.github.com

# ssh or openpgp
SIGNING_FORMAT=ssh

# file or openbao
SIGNING_KEY_SOURCE=openbao
# SIGNING_KEY_FILE=/run/secrets/git_signing_private_key

# env or openbao
GITHUB_TOKEN_SOURCE=openbao
# GITHUB_TOKEN=github_pat_xxx
# GITHUB_TOKEN_FILE=/run/secrets/github_token
GITHUB_API_URL=https://api.github.com

# OpenBao AppRole + KV v2
OPENBAO_ADDR=https://openbao.example.com
OPENBAO_ROLE_ID=
OPENBAO_SECRET_ID=
# Prefer *_FILE in production:
# OPENBAO_ROLE_ID_FILE=/run/secrets/openbao_role_id
# OPENBAO_SECRET_ID_FILE=/run/secrets/openbao_secret_id
OPENBAO_AUTH_MOUNT=approle
OPENBAO_KV_MOUNT=secret
OPENBAO_NAMESPACE=

OPENBAO_SIGNING_PATH=git-signing/signing
OPENBAO_SIGNING_FIELD=private_key
OPENBAO_GITHUB_PATH=git-signing/github
OPENBAO_GITHUB_FIELD=token
OPENBAO_MCP_AUTH_PATH=git-signing/mcp
OPENBAO_MCP_AUTH_FIELD=token

VERIFY_RETRIES=6

# Used by docker-compose.override.yml
PROXY_NETWORK=nginx-proxy
