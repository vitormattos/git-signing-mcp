# OpenAI Secure MCP Tunnel.
# Create the tunnel in the OpenAI Platform and keep the ChatGPT app private.
OPENAI_TUNNEL_ID=tunnel_0123456789abcdef0123456789abcdef
OPENAI_TUNNEL_RUNTIME_API_KEY=replace-with-runtime-api-key

# Defense-in-depth token used only on the local tunnel-client -> MCP hop.
# Generate with: openssl rand -hex 32
MCP_TUNNEL_SHARED_SECRET=replace-with-at-least-32-random-characters

# MCP binds only inside this Compose network. No host port is published.
MCP_HOST=0.0.0.0
MCP_PORT=8080
MCP_ALLOWED_HOSTS=mcp,mcp:8080
MCP_ALLOWED_ORIGINS=

# Repository policy. "*/*" allows any repository that the GitHub credential can access.
ALLOWED_REPOSITORIES=*/*
PROTECTED_BRANCH_PATTERNS=main,master,trunk,production,release/*
ALLOW_PROTECTED_BRANCH_WRITES=false
MAX_WRITES_PER_MINUTE=10
MAX_CONCURRENT_WRITES=1
MAX_FILE_BYTES=1048576
MAX_CHANGES=100

# Git identity used for BOTH author and DCO Signed-off-by.
GIT_IDENTITY_NAME=Vitor Mattos
GIT_IDENTITY_EMAIL=1079143+vitormattos@users.noreply.github.com

# ssh or openpgp
SIGNING_FORMAT=ssh

# file or openbao
SIGNING_KEY_SOURCE=openbao
# SIGNING_KEY_FILE=/run/secrets/git_signing_private_key

# env or openbao
GITHUB_TOKEN_SOURCE=openbao
# GITHUB_TOKEN=github_pat_xxx
# GITHUB_TOKEN_FILE=/run/secrets/github_token
GITHUB_API_URL=https://api.github.com

# OpenBao AppRole + KV v2
OPENBAO_ADDR=https://openbao.example.com
OPENBAO_ROLE_ID=
OPENBAO_SECRET_ID=
# Prefer *_FILE in production:
# OPENBAO_ROLE_ID_FILE=/run/secrets/openbao_role_id
# OPENBAO_SECRET_ID_FILE=/run/secrets/openbao_secret_id
OPENBAO_AUTH_MOUNT=approle
OPENBAO_KV_MOUNT=secret
OPENBAO_NAMESPACE=

OPENBAO_SIGNING_PATH=git-signing/signing
OPENBAO_SIGNING_FIELD=private_key
OPENBAO_GITHUB_PATH=git-signing/github
OPENBAO_GITHUB_FIELD=token

VERIFY_RETRIES=6
